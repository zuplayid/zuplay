
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuplay-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zuplay-db",
      "database_id": "c71bd9d4-c39a-42a0-bb39-afdb80d06916"
    }
  ]
}
